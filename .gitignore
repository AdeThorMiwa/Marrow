# Go (api/)
api/tmp/
api/.env
api/*.exe
api/*.exe~
api/*.dll
api/*.so
api/*.dylib
api/marrow

api/configs/stage.yaml
api/configs/prod.yaml

# Operational scripts / session state — machine-specific, never committed
api/marrow-service.sh
api/**/*.db

# whisper-server debug dumps (written to whatever its CWD happens to be)
whisper-server-*.wav

# Expo / React Native (app/)
app/node_modules/
app/.expo/
app/dist/
app/web-build/
app/expo-env.d.ts

# Native — generated by `expo prebuild`, never committed
app/ios/
app/android/

app/.kotlin/
app/*.orig.*
app/*.jks
app/*.p8
app/*.p12
app/*.key
app/*.mobileprovision

# Metro
app/.metro-health-check*

# debug logs
app/npm-debug.*
app/yarn-debug.*
app/yarn-error.*

# local env files
app/.env*.local

# TypeScript
app/*.tsbuildinfo

# Editor & OS
.DS_Store
*.pem
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.log
